<!-- views/home.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TechPay Index | Programmatic SEO Tech Compensation & Role Directory</title>
  <meta name="description" content="Explore data-driven tech compensation benchmarks, cost-of-living insights, and localized career FAQs across top US technology hubs." />
  <link rel="canonical" href="<%= siteUrl %>/" />
  <meta property="og:title" content="TechPay Index | Tech Compensation & Role Directory" />
  <meta property="og:description" content="Data-driven salary guides, localized market analysis, and FAQs for engineering and data roles across major tech hubs." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col selection:bg-indigo-600 selection:text-white">

  <header class="bg-white/90 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-extrabold text-lg shadow-sm group-hover:bg-indigo-700 transition">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight text-slate-900">TechPay</span>
          <span class="hidden sm:inline-block text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 ml-1">Directory</span>
        </div>
      </a>
      <nav class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-slate-600">
        <a href="/" class="text-indigo-600 font-semibold">All Guides</a>
        <a href="/about" class="hover:text-indigo-600 transition">About Us</a>
        <a href="/contact" class="hover:text-indigo-600 transition">Contact</a>
        <a href="/privacy" class="hover:text-indigo-600 transition">Privacy Policy</a>
      </nav>
    </div>
  </header>

  <section class="relative overflow-hidden bg-slate-900 text-white py-16 sm:py-24 border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-900/40 via-slate-900 to-slate-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 mb-6">
        Verified Compensation Intelligence
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight max-w-4xl mx-auto leading-tight">
        Tech Salary &amp; Market Intelligence Directory
      </h1>
      <p class="mt-5 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Browse localized compensation guides, cost-of-living breakdowns, salary percentiles, and role-specific FAQs across leading US technology hubs.
      </p>

      <form action="/" method="GET" class="mt-8 max-w-2xl mx-auto flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <input
            type="text"
            name="q"
            value="<%= searchQuery %>"
            placeholder="Search by role, city, or keyword (e.g., Machine Learning, Austin, Seattle)..."
            class="w-full px-4 py-3.5 rounded-xl bg-white/10 border border-white/15 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-slate-800 transition text-sm sm:text-base"
          />
        </div>
        <button
          type="submit"
          class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm sm:text-base shadow-lg shadow-indigo-600/25 transition shrink-0"
        >
          Search Directory
        </button>
        <% if (searchQuery) { %>
          <a
            href="/"
            class="px-4 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium text-sm sm:text-base transition shrink-0 text-center"
          >
            Reset
          </a>
        <% } %>
      </form>
    </div>
  </section>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <% if (typeof notFoundSlug !== 'undefined' && notFoundSlug) { %>
      <div class="mb-8 rounded-2xl bg-amber-50 border border-amber-200 p-5 text-amber-900 flex items-center justify-between">
        <div>
          <p class="font-semibold text-sm uppercase tracking-wider text-amber-700">Page Not Found (404)</p>
          <p class="mt-1 text-sm">We couldn't find a report matching <code class="px-1.5 py-0.5 rounded bg-amber-100 font-mono text-xs">/<%= notFoundSlug %></code>. Explore all available market reports below.</p>
        </div>
        <a href="/" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-amber-900 text-white hover:bg-amber-800 transition">Dismiss</a>
      </div>
    <% } %>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
          <% if (searchQuery) { %>
            Search Results for "<%= searchQuery %>"
          <% } else { %>
            Indexed Compensation Reports
          <% } %>
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Showing <span class="font-semibold text-slate-800"><%= pages.length %></span> comprehensive regional salary guides
        </p>
      </div>
    </div>

    <% if (pages.length === 0) { %>
      <div class="mt-12 bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 mx-auto flex items-center justify-center font-bold text-xl">
          0
        </div>
        <h3 class="mt-4 text-lg font-bold text-slate-900">No Directory Pages Found</h3>
        <p class="mt-2 text-sm text-slate-600 max-w-md mx-auto">
          <% if (searchQuery) { %>
            No pages matched your filter criteria. Try clearing your search query.
          <% } else { %>
            Your SQLite database (<code class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded">data.db</code>) does not have any rows yet. Run <code class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded">python pipeline.py</code> to populate it.
          <% } %>
        </p>
      </div>
    <% } else { %>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% pages.forEach(function(item) { %>
          <article class="relative group bg-white rounded-2xl border border-slate-200/90 hover:border-indigo-500/60 shadow-sm hover:shadow-xl hover:shadow-indigo-950/5 transition-all duration-200 flex flex-col justify-between p-6">
            <div>
              <div class="flex items-center justify-between gap-2 text-xs text-slate-500 mb-3">
                <span class="font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md truncate max-w-[220px]">
                  /<%= item.slug %>
                </span>
                <time datetime="<%= item.created_at %>" class="shrink-0">
                  <%= item.created_at ? item.created_at.split(' ')[0] : 'Recent' %>
                </time>
              </div>

              <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition leading-snug">
                <a href="/<%= item.slug %>" class="focus:outline-none">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  <%= item.title %>
                </a>
              </h3>

              <p class="mt-3 text-sm text-slate-600 line-clamp-3 leading-relaxed">
                <%= item.description.replace(/\n+/g, ' ').slice(0, 190) %>...
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold">
              <span class="text-slate-500">
                <%= item.faqs ? item.faqs.length : 0 %> Local FAQs Included
              </span>
              <span class="text-indigo-600 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                Read Report &rarr;
              </span>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>

    <!-- Editorial Overview Section for Reader Value & AdSense Quality Compliance -->
    <section class="mt-16 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
      <div class="max-w-4xl">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">How to Use This Directory</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mt-1">
          Data-Driven Compensation Benchmarks for Engineering &amp; Data Careers
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          Whether you are preparing for an upcoming performance review, evaluating a relocation offer, or benchmarking engineering budgets, <strong>TechPay Index</strong> provides structured salary intelligence across top technology markets. Each guide compares 25th, 50th (median), and 75th percentile base pay alongside local cost-of-living multipliers, equity vesting norms, and sector-specific hiring trends.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm font-semibold">
          <a href="/about" class="text-indigo-600 hover:text-indigo-700">Learn about our methodology &rarr;</a>
          <span class="text-slate-300">|</span>
          <a href="/contact" class="text-indigo-600 hover:text-indigo-700">Request a role or city benchmark &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-white border-t border-slate-200 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/" class="hover:text-slate-900 transition">Home</a>
        <a href="/about" class="hover:text-slate-900 transition">About Us</a>
        <a href="/contact" class="hover:text-slate-900 transition">Contact Us</a>
        <a href="/privacy" class="hover:text-slate-900 transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-slate-900 transition">Sitemap</a>
      </div>
    </div>
  </footer>

</body>
</html>
