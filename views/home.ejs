<!-- views/home.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TechPay Directory | AI Architecture, Cloud FinOps &amp; Tech Compensation Benchmarks (2026)</title>
  <meta name="description" content="Explore 125+ in-depth technical architecture blueprints, AI/RAG production benchmarks, cloud FinOps playbooks, and localized tech salary guides with interactive calculators." />
  <link rel="canonical" href="<%= siteUrl %>/" />
  <meta property="og:title" content="TechPay Directory | Engineering & Compensation Intelligence" />
  <meta property="og:description" content="125+ verified technical implementation blueprints, comparison matrices, and localized compensation reports." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/" />
  <!-- Google AdSense Auto-Ads Verification Script -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] }
        }
      }
    };
    (function() {
      const saved = localStorage.getItem('techpay_theme');
      if (saved === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --mouse-x: 50vw;
      --mouse-y: 30vh;
    }
    body { font-family: 'Inter', sans-serif; }

    #cursor-spotlight {
      background: radial-gradient(
        650px circle at var(--mouse-x) var(--mouse-y),
        rgba(99, 102, 241, 0.14),
        rgba(14, 165, 233, 0.06) 40%,
        transparent 70%
      );
    }
    html:not(.dark) #cursor-spotlight {
      background: radial-gradient(
        650px circle at var(--mouse-x) var(--mouse-y),
        rgba(99, 102, 241, 0.11),
        rgba(14, 165, 233, 0.05) 40%,
        transparent 70%
      );
    }

    .spotlight-card {
      position: relative;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.84);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(15, 23, 42, 0.08);
      box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.06);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s ease, box-shadow 0.28s ease, background-color 0.3s ease;
    }
    .dark .spotlight-card {
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 15px 35px -12px rgba(0, 0, 0, 0.45);
    }
    .spotlight-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(
        420px circle at var(--card-x, -500px) var(--card-y, -500px),
        rgba(99, 102, 241, 0.18),
        rgba(56, 189, 248, 0.06) 45%,
        transparent 75%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: 0;
    }
    .spotlight-card:hover::before {
      opacity: 1;
    }
    .spotlight-card:hover {
      border-color: rgba(99, 102, 241, 0.48);
      box-shadow: 0 22px 45px -15px rgba(79, 70, 229, 0.22);
    }
    .spotlight-card > * {
      position: relative;
      z-index: 1;
    }
  </style>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "TechPay SEO Directory",
    "url": siteUrl + "/",
    "description": "In-depth engineering blueprints, AI system benchmarks, and localized technology compensation guides.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": siteUrl + "/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }) %>
  </script>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-[#050814] dark:text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white relative overflow-x-hidden transition-colors duration-300">

  <div id="cursor-spotlight" class="fixed inset-0 pointer-events-none z-0"></div>

  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-500/15 dark:bg-indigo-600/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-sky-400/15 dark:bg-sky-500/15 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 w-96 h-96 bg-emerald-400/10 dark:bg-emerald-500/10 rounded-full blur-3xl"></div>
  </div>

  <!-- Sticky Header -->
  <header class="bg-white/80 dark:bg-[#050814]/80 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800/80 sticky top-0 z-40 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-sky-500 to-emerald-400 flex items-center justify-center text-white font-extrabold text-lg shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition-transform">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-slate-900 via-indigo-800 to-indigo-600 dark:from-white dark:via-slate-100 dark:to-indigo-300 bg-clip-text text-transparent">TechPay</span>
          <span class="hidden sm:inline-block text-[11px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:bg-indigo-500/15 dark:text-indigo-300 border border-indigo-500/25 ml-1.5">
            2026 Index
          </span>
        </div>
      </a>

      <div class="flex items-center gap-4 sm:gap-6">
        <nav class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-300">
          <a href="/" class="text-indigo-600 dark:text-white font-semibold">Home</a>
          <a href="#categories-hub" class="hidden sm:inline hover:text-indigo-600 dark:hover:text-white transition">Categories</a>
          <a href="#interactive-estimator" class="hidden md:inline hover:text-indigo-600 dark:hover:text-white transition">Salary Calculator</a>
          <a href="/about" class="hover:text-indigo-600 dark:hover:text-white transition">About Us</a>
          <a href="/contact" class="hover:text-indigo-600 dark:hover:text-white transition">Contact</a>
          <a href="/privacy" class="hover:text-indigo-600 dark:hover:text-white transition">Privacy Policy</a>
        </nav>

        <button
          id="themeToggleBtn"
          type="button"
          onclick="toggleTheme()"
          aria-label="Toggle Dark or Light Mode"
          class="relative inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-200/90 dark:border-slate-700/80 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-sm transition-all duration-200 hover:scale-105"
        >
          <svg class="w-4 h-4 text-amber-400 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 text-indigo-600 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span id="themeToggleLabel" class="hidden sm:inline">Theme</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative z-10 pt-14 pb-16 sm:pt-20 sm:pb-20 border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/25 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
        <span><%= pages.length %> In-Depth Engineering Blueprints &amp; Regional Compensation Reports</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight max-w-4xl mx-auto leading-[1.12] text-slate-900 dark:text-white">
        Production Systems Architecture, AI Benchmarks &amp; <span class="bg-gradient-to-r from-indigo-600 via-sky-500 to-emerald-500 dark:from-indigo-400 dark:via-sky-400 dark:to-emerald-400 bg-clip-text text-transparent">Compensation Intelligence</span>
      </h1>

      <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        An independent technical reference hub featuring 4-phase engineering implementation blueprints, side-by-side performance comparison tables, architectural trade-off analyses, and tax-adjusted tech salary calculators across 8 global hubs.
      </p>

      <!-- Search Bar -->
      <form action="/" method="GET" class="mt-9 max-w-2xl mx-auto flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <input
            id="liveSearchInput"
            type="text"
            name="q"
            value="<%= searchQuery %>"
            placeholder="Search by topic, stack, role, or city (e.g., RAG, PostgreSQL, Karpenter, Austin, London)..."
            class="w-full pl-5 pr-4 py-4 rounded-2xl bg-white/95 dark:bg-slate-900/90 border border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition text-sm sm:text-base shadow-lg"
          />
        </div>
        <button
          type="submit"
          class="px-7 py-4 rounded-2xl bg-gradient-to-r from-indigo-600 to-sky-600 hover:from-indigo-500 hover:to-sky-500 text-white font-semibold text-sm sm:text-base shadow-lg shadow-indigo-600/25 transition shrink-0"
        >
          Search Directory
        </button>
        <% if (searchQuery) { %>
          <a
            href="/"
            class="px-5 py-4 rounded-2xl bg-slate-200 hover:bg-slate-300 dark:bg-slate-900 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-800 font-medium text-sm sm:text-base transition shrink-0 text-center"
          >
            Reset
          </a>
        <% } %>
      </form>
    </div>
  </section>

  <!-- Main Content -->
  <main class="relative z-10 flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <% if (typeof notFoundSlug !== 'undefined' && notFoundSlug) { %>
      <div class="rounded-2xl bg-amber-500/10 border border-amber-500/30 p-5 text-amber-800 dark:text-amber-200 flex items-center justify-between">
        <div>
          <p class="font-semibold text-xs uppercase tracking-wider text-amber-600 dark:text-amber-400">Report Not Found (404)</p>
          <p class="mt-1 text-sm">We couldn't find a report matching <code class="px-1.5 py-0.5 rounded bg-amber-500/20 font-mono text-xs">/<%= notFoundSlug %></code>. Explore our curated category hubs below.</p>
        </div>
        <a href="/" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 transition">Dismiss</a>
      </div>
    <% } %>

    <!-- 1. Curated Category Hubs -->
    <% if (!searchQuery && typeof categories !== 'undefined' && categories.length > 0) { %>
      <section id="categories-hub" class="scroll-mt-20">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Structured Knowledge Clusters</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
              Explore by Technical &amp; Career Domain
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            Click any domain cluster to filter reports instantly
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <% categories.forEach(function(cat) { %>
            <button
              type="button"
              onclick="filterByKeyword('<%= cat.name.toLowerCase() %>'); document.getElementById('directory-index').scrollIntoView({behavior: 'smooth'});"
              class="text-left spotlight-card rounded-2xl p-6 hover:-translate-y-1 transition flex flex-col justify-between group"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-500/10 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300 border border-indigo-500/25">
                    <%= cat.name %>
                  </span>
                  <span class="text-xs font-mono font-semibold text-slate-500 dark:text-slate-400">
                    <%= cat.count %> Guides
                  </span>
                </div>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  <%= cat.description %>
                </p>
              </div>
              <span class="mt-4 text-xs font-semibold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Filter <%= cat.name %> cluster &rarr;
              </span>
            </button>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- 2. Featured Pillar Blueprints -->
    <% if (!searchQuery && typeof featuredPages !== 'undefined' && featuredPages.length > 0) { %>
      <section>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Editor's Pillar Selections</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
              Flagship 2026 Architecture &amp; Salary Guides
            </h2>
          </div>
          <span class="text-xs text-slate-500 dark:text-slate-400">Includes 4-Phase Blueprints, Comparison Tables &amp; Trade-Offs</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% featuredPages.forEach(function(fp) { %>
            <article class="spotlight-card rounded-2xl p-6 border-indigo-500/30 hover:-translate-y-1.5 transition flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 text-xs mb-3">
                  <span class="px-2.5 py-1 rounded-md bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 font-bold uppercase tracking-wider">
                    ★ Pillar Guide &bull; <%= fp.category %>
                  </span>
                </div>
                <h3 class="text-lg font-extrabold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition leading-snug">
                  <a href="/<%= fp.slug %>">
                    <span class="absolute inset-0" aria-hidden="true"></span>
                    <%= fp.title %>
                  </a>
                </h3>
                <% if (fp.meta && fp.meta.kpis && fp.meta.kpis[0]) { %>
                  <div class="mt-3 p-2.5 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-xs font-semibold text-indigo-800 dark:text-indigo-200">
                    Benchmark: <%= fp.meta.kpis[0].value %>
                  </div>
                <% } %>
                <p class="mt-3 text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">
                  <%= (fp.meta && fp.meta.overview_paragraphs && fp.meta.overview_paragraphs[0] ? fp.meta.overview_paragraphs[0] : fp.description).slice(0, 180) %>...
                </p>
              </div>
              <div class="mt-5 pt-4 border-t border-slate-200/70 dark:border-slate-800 flex items-center justify-between text-xs font-semibold">
                <span class="text-slate-500 dark:text-slate-400"><%= fp.city %></span>
                <span class="text-indigo-600 dark:text-indigo-400">Open Full Blueprint &rarr;</span>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- 3. Interactive Compensation & Take-Home Pay Sandbox -->
    <section id="interactive-estimator" class="spotlight-card rounded-2xl p-6 sm:p-10 scroll-mt-20">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Interactive Benchmarking Utility</span>
          <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1">
            2026 Tech Total Comp &amp; Purchasing Power Calculator
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Compare nominal coastal compensation packages against zero-income-tax hubs (Austin, Seattle) by modeling base salary, target bonus, 4-year RSU grants, and effective tax rates.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="homeBase" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">Base Salary ($)</label>
            <input id="homeBase" type="number" value="185000" step="5000" oninput="runHomeCalc()" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm font-semibold" />
          </div>
          <div>
            <label for="homeBonus" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">Annual Bonus (%)</label>
            <input id="homeBonus" type="number" value="15" step="1" oninput="runHomeCalc()" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm font-semibold" />
          </div>
          <div>
            <label for="homeRsu" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">4-Yr RSU Grant ($)</label>
            <input id="homeRsu" type="number" value="240000" step="10000" oninput="runHomeCalc()" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm font-semibold" />
          </div>
          <div>
            <label for="homeHubTax" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">Tech Hub Tax Tier</label>
            <select id="homeHubTax" onchange="runHomeCalc()" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm font-semibold">
              <option value="36">San Francisco / CA (~36% Eff.)</option>
              <option value="37">New York City / NY (~37% Eff.)</option>
              <option value="25">Seattle / WA (0% State, ~25% Eff.)</option>
              <option value="25">Austin / TX (0% State, ~25% Eff.)</option>
              <option value="29">Boston / MA (~29% Eff.)</option>
              <option value="28">Denver / CO (~28% Eff.)</option>
            </select>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-gradient-to-br from-indigo-600/15 via-sky-500/10 to-emerald-500/10 border border-indigo-500/30 space-y-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Annual Total Comp (TC)</span>
            <p id="homeOutTC" class="text-3xl font-extrabold text-indigo-600 dark:text-indigo-300">$272,750</p>
          </div>
          <div class="pt-3 border-t border-slate-200/60 dark:border-slate-800">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Estimated Net Take-Home</span>
            <p id="homeOutNet" class="text-xl font-bold text-emerald-600 dark:text-emerald-400">$174,560 / yr</p>
            <p id="homeOutMo" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">~$14,547 / month after tax</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Complete Filterable Directory Index -->
    <section id="directory-index" class="scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-slate-800/80">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            <% if (searchQuery) { %>
              Search Results for "<%= searchQuery %>"
            <% } else { %>
              Complete Technical &amp; Compensation Report Index
            <% } %>
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Showing <span id="visibleCountLabel" class="font-semibold text-indigo-600 dark:text-indigo-400"><%= pages.length %></span> comprehensive guides with comparison matrices &amp; structured FAQs
          </p>
        </div>

        <button
          type="button"
          onclick="filterByKeyword('')"
          class="text-xs font-semibold px-3.5 py-2 rounded-xl bg-slate-200/80 dark:bg-slate-900 hover:bg-indigo-600 hover:text-white transition self-start sm:self-auto"
        >
          Show All <%= pages.length %> Guides
        </button>
      </div>

      <% if (pages.length === 0) { %>
        <div class="mt-12 spotlight-card rounded-2xl p-12 text-center">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">No Matching Guides Found</h3>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto">
            Try clearing your search filter or selecting one of the domain clusters above.
          </p>
        </div>
      <% } else { %>
        <div id="cardsGrid" class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% pages.forEach(function(item) { %>
            <article
              data-search="<%= (item.title + ' ' + item.slug + ' ' + item.category + ' ' + item.city + ' ' + item.description).toLowerCase() %>"
              class="directory-card spotlight-card group rounded-2xl p-6 hover:-translate-y-1.5 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 text-xs mb-3">
                  <span class="px-2.5 py-1 rounded-md font-bold bg-indigo-500/10 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300 border border-indigo-500/20">
                    <%= item.category %>
                  </span>
                  <span class="text-slate-500 dark:text-slate-400 font-medium truncate">
                    <%= item.city %>
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition leading-snug">
                  <a href="/<%= item.slug %>" class="focus:outline-none">
                    <span class="absolute inset-0" aria-hidden="true"></span>
                    <%= item.title %>
                  </a>
                </h3>

                <% if (item.meta && item.meta.kpis && item.meta.kpis[0]) { %>
                  <p class="mt-2.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
                    ▸ <%= item.meta.kpis[0].value %>
                  </p>
                <% } %>

                <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-300/90 line-clamp-3 leading-relaxed">
                  <%= (item.meta && item.meta.overview_paragraphs && item.meta.overview_paragraphs[0] ? item.meta.overview_paragraphs[0] : item.description).replace(/\n+/g, ' ').slice(0, 185) %>...
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-200/70 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold">
                <span class="inline-flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
                  4-Phase Blueprint + Matrix
                </span>
                <span class="text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  Read Guide &rarr;
                </span>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

    <!-- Editorial Standards & Transparency Section -->
    <section class="spotlight-card rounded-2xl p-8 sm:p-10">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2 space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Editorial Quality &amp; Data Integrity</span>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
            How TechPay Directory Curates &amp; Verifies Benchmarks
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Every guide in <strong>TechPay Directory</strong> is structured to provide actionable utility for software engineers, architects, and hiring managers. Our reports combine empirical systems performance metrics, 4-stage implementation roadmaps, comparative trade-off tables, and localized tax/cost-of-living adjustments across 8 major technology hubs.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3">
          <a href="/about" class="px-5 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-sky-600 hover:from-indigo-500 hover:to-sky-500 text-white font-semibold text-sm text-center shadow-md transition">
            Read Our Editorial Policy &rarr;
          </a>
          <a href="/contact" class="px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700 font-semibold text-sm text-center transition">
            Submit Data or Feedback
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Global Footer -->
  <footer class="relative z-10 border-t border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-[#050814]/90 backdrop-blur-md mt-16 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/" class="hover:text-indigo-600 dark:hover:text-white transition">Home</a>
        <a href="/about" class="hover:text-indigo-600 dark:hover:text-white transition">About Us</a>
        <a href="/contact" class="hover:text-indigo-600 dark:hover:text-white transition">Contact Us</a>
        <a href="/privacy" class="hover:text-indigo-600 dark:hover:text-white transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-indigo-600 dark:hover:text-white transition">XML Sitemap</a>
      </div>
    </div>
  </footer>

  <script>
    function updateThemeUI() {
      const isDark = document.documentElement.classList.contains('dark');
      const label = document.getElementById('themeToggleLabel');
      if (label) {
        label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
      }
    }

    function toggleTheme() {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      localStorage.setItem('techpay_theme', isDark ? 'dark' : 'light');
      updateThemeUI();
    }
    updateThemeUI();

    function runHomeCalc() {
      const base = parseFloat(document.getElementById('homeBase').value) || 0;
      const bonusPct = parseFloat(document.getElementById('homeBonus').value) || 0;
      const rsuFour = parseFloat(document.getElementById('homeRsu').value) || 0;
      const taxRate = parseFloat(document.getElementById('homeHubTax').value) || 30;

      const gross = Math.round(base + base * (bonusPct / 100) + rsuFour / 4);
      const net = Math.round(gross * (1 - taxRate / 100));
      const mo = Math.round(net / 12);

      document.getElementById('homeOutTC').textContent = '$' + gross.toLocaleString();
      document.getElementById('homeOutNet').textContent = '$' + net.toLocaleString() + ' / yr';
      document.getElementById('homeOutMo').textContent = '~$' + mo.toLocaleString() + ' / month after tax';
    }
    runHomeCalc();

    window.addEventListener('mousemove', (e) => {
      document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
      document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
    }, { passive: true });

    document.querySelectorAll('.spotlight-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--card-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--card-y', `${e.clientY - rect.top}px`);
      }, { passive: true });
    });

    const searchInput = document.getElementById('liveSearchInput');
    const cards = Array.from(document.querySelectorAll('.directory-card'));
    const countLabel = document.getElementById('visibleCountLabel');

    function applyClientFilter(term) {
      const normalized = (term || '').toLowerCase().trim();
      let visible = 0;
      cards.forEach((card) => {
        const haystack = card.getAttribute('data-search') || '';
        if (!normalized || haystack.includes(normalized)) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      if (countLabel) {
        countLabel.textContent = String(visible);
      }
    }

    function filterByKeyword(keyword) {
      if (searchInput) {
        searchInput.value = keyword;
      }
      applyClientFilter(keyword);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        applyClientFilter(e.target.value);
      });
    }
  </script>
</body>
</html>
