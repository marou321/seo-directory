<!-- views/privacy.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy Policy | TechPay Directory</title>
  <meta name="description" content="Official Privacy Policy for TechPay Directory, covering cookies, log files, Google AdSense, DoubleClick DART cookies, and GDPR/CCPA user data rights." />
  <link rel="canonical" href="<%= siteUrl %>/privacy" />
  <meta property="og:title" content="Privacy Policy | TechPay Directory" />
  <meta property="og:description" content="Privacy Policy and Google AdSense transparency disclosures for TechPay Directory." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/privacy" />
  <!-- Google AdSense Auto-Ads Verification Script -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
    .glass-card {
      background: rgba(15, 23, 42, 0.68);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white relative overflow-x-hidden">

  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-sky-500/15 rounded-full blur-3xl"></div>
  </div>

  <header class="bg-slate-950/75 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-sky-500 to-emerald-400 flex items-center justify-center text-slate-950 font-extrabold text-lg shadow-lg shadow-indigo-500/25">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-white via-slate-100 to-indigo-300 bg-clip-text text-transparent">TechPay</span>
          <span class="hidden sm:inline-block text-[11px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 ml-1.5">
            Directory
          </span>
        </div>
      </a>
      <nav class="flex flex-wrap items-center gap-4 sm:gap-7 text-xs sm:text-sm font-medium text-slate-300">
        <a href="/" class="hover:text-white transition">Home</a>
        <a href="/about" class="hover:text-white transition">About Us</a>
        <a href="/contact" class="hover:text-white transition">Contact</a>
        <a href="/privacy" class="text-white font-semibold">Privacy Policy</a>
      </nav>
    </div>
  </header>

  <section class="py-14 sm:py-20 border-b border-slate-800/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 mb-4">
        Legal &amp; AdSense Transparency
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Privacy Policy
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto">
        Effective &amp; Last Updated: <%= new Date().toISOString().slice(0, 10) %>
      </p>
    </div>
  </section>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <article class="glass-card rounded-2xl p-6 sm:p-10 space-y-6 text-slate-300 text-sm sm:text-base leading-relaxed">
      <div>
        <h2 class="text-xl font-bold text-white">1. Introduction</h2>
        <p class="mt-2">
          At <strong>TechPay Directory</strong> (<code class="text-xs bg-slate-900 px-1.5 py-0.5 rounded text-indigo-300"><%= siteUrl %></code>), we respect and protect the privacy of our visitors. This Privacy Policy explains what information we collect, how we use it, and your choices regarding cookies and personalized advertising.
        </p>
      </div>

      <div class="border-t border-slate-800 pt-6">
        <h2 class="text-xl font-bold text-white">2. Log Files &amp; First-Party Telemetry</h2>
        <p class="mt-2">
          Like standard web servers, TechPay Directory logs non-personally identifiable request metadata—such as requested page paths, date/time stamps, and anonymized IP addresses—solely to monitor server health, analyze aggregate traffic trends, and improve the quality of our published guides.
        </p>
      </div>

      <div class="border-t border-slate-800 pt-6">
        <h2 class="text-xl font-bold text-white">3. Google AdSense &amp; DoubleClick DART Cookie Disclosure</h2>
        <p class="mt-2">
          TechPay Directory displays advertisements served by <strong>Google AdSense</strong>:
        </p>
        <ul class="mt-3 space-y-2 list-disc list-inside">
          <li>Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites on the internet.</li>
          <li>Google's use of advertising cookies (including the DoubleClick DART cookie) enables it and its partners to serve relevant ads to users based on their visit to our site and/or other sites on the Internet.</li>
          <li>Users may opt out of personalized advertising at any time by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-indigo-400 font-semibold hover:underline">Google Ads Settings</a> or <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer" class="text-indigo-400 font-semibold hover:underline">Google Privacy &amp; Terms</a>.</li>
          <li>You can also opt out of third-party vendor cookies for personalized advertising at <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="text-indigo-400 font-semibold hover:underline">www.aboutads.info/choices</a>.</li>
        </ul>
      </div>

      <div class="border-t border-slate-800 pt-6">
        <h2 class="text-xl font-bold text-white">4. GDPR &amp; CCPA Privacy Rights</h2>
        <p class="mt-2">
          Visitors residing in the European Economic Area (EEA), the United Kingdom, or California have the right to request access to, correction of, or deletion of personal data, as well as the right to opt out of personalized advertising cookies. To exercise these rights, please contact us via our <a href="/contact" class="text-indigo-400 font-semibold hover:underline">Contact Us</a> page.
        </p>
      </div>
    </article>
  </main>

  <footer class="border-t border-slate-800/80 bg-slate-950/90 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/" class="hover:text-white transition">Home</a>
        <a href="/about" class="hover:text-white transition">About Us</a>
        <a href="/contact" class="hover:text-white transition">Contact Us</a>
        <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-white transition">XML Sitemap</a>
      </div>
    </div>
  </footer>

</body>
</html>
