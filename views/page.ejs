<!-- views/page.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= page.title %> | TechPay Directory</title>
  <meta name="description" content="<%= page.description.replace(/\n+/g, ' ').slice(0, 158) %>" />
  <link rel="canonical" href="<%= siteUrl %>/<%= page.slug %>" />
  <meta property="og:title" content="<%= page.title %>" />
  <meta property="og:description" content="<%= page.description.replace(/\n+/g, ' ').slice(0, 158) %>" />
  <meta property="og:type" content="article" />
  <meta property="og:url" content="<%= siteUrl %>/<%= page.slug %>" />
  <!-- Google AdSense Auto-Ads Verification Script -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] }
        }
      }
    };
    (function() {
      const saved = localStorage.getItem('techpay_theme');
      if (saved === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --mouse-x: 50vw;
      --mouse-y: 30vh;
    }
    body { font-family: 'Inter', sans-serif; }

    #cursor-spotlight {
      background: radial-gradient(
        650px circle at var(--mouse-x) var(--mouse-y),
        rgba(99, 102, 241, 0.14),
        rgba(14, 165, 233, 0.06) 40%,
        transparent 70%
      );
    }
    html:not(.dark) #cursor-spotlight {
      background: radial-gradient(
        650px circle at var(--mouse-x) var(--mouse-y),
        rgba(99, 102, 241, 0.11),
        rgba(14, 165, 233, 0.05) 40%,
        transparent 70%
      );
    }

    .spotlight-card {
      position: relative;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.84);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(15, 23, 42, 0.08);
      box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.06);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s ease, box-shadow 0.28s ease, background-color 0.3s ease;
    }
    .dark .spotlight-card {
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 15px 35px -12px rgba(0, 0, 0, 0.45);
    }
    .spotlight-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(
        480px circle at var(--card-x, -500px) var(--card-y, -500px),
        rgba(99, 102, 241, 0.16),
        rgba(56, 189, 248, 0.05) 45%,
        transparent 75%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: 0;
    }
    .spotlight-card:hover::before {
      opacity: 1;
    }
    .spotlight-card:hover {
      border-color: rgba(99, 102, 241, 0.45);
    }
    .spotlight-card > * {
      position: relative;
      z-index: 1;
    }
  </style>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": page.title,
        "description": page.description.replace(/\n+/g, ' ').slice(0, 160),
        "datePublished": page.created_at || new Date().toISOString(),
        "dateModified": page.created_at || new Date().toISOString(),
        "mainEntityOfPage": siteUrl + "/" + page.slug,
        "author": {
          "@type": "Organization",
          "name": "TechPay SEO Directory"
        }
      },
      ...(page.faqs && page.faqs.length > 0 ? [{
        "@type": "FAQPage",
        "mainEntity": page.faqs.map(function(f) {
          return {
            "@type": "Question",
            "name": f.question,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": f.answer
            }
          };
        })
      }] : [])
    ]
  }) %>
  </script>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-[#050814] dark:text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white relative overflow-x-hidden transition-colors duration-300">

  <!-- Dynamic Mouse-Tracking Spotlight -->
  <div id="cursor-spotlight" class="fixed inset-0 pointer-events-none z-0"></div>

  <!-- Ambient Glows -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-indigo-500/15 dark:bg-indigo-600/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-sky-400/15 dark:bg-sky-500/15 rounded-full blur-3xl"></div>
  </div>

  <!-- Header Navigation -->
  <header class="bg-white/80 dark:bg-[#050814]/80 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800/80 sticky top-0 z-40 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-sky-500 to-emerald-400 flex items-center justify-center text-white font-extrabold text-lg shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition-transform">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-slate-900 via-indigo-800 to-indigo-600 dark:from-white dark:via-slate-100 dark:to-indigo-300 bg-clip-text text-transparent">TechPay</span>
          <span class="hidden sm:inline-block text-[11px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:bg-indigo-500/15 dark:text-indigo-300 border border-indigo-500/25 ml-1.5">
            Directory
          </span>
        </div>
      </a>

      <div class="flex items-center gap-4 sm:gap-6">
        <nav class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-300">
          <a href="/" class="hover:text-indigo-600 dark:hover:text-white transition">All Guides</a>
          <a href="/about" class="hover:text-indigo-600 dark:hover:text-white transition">About Us</a>
          <a href="/contact" class="hover:text-indigo-600 dark:hover:text-white transition">Contact</a>
          <a href="/privacy" class="hover:text-indigo-600 dark:hover:text-white transition">Privacy Policy</a>
        </nav>

        <button
          id="themeToggleBtn"
          type="button"
          onclick="toggleTheme()"
          aria-label="Toggle Dark or Light Mode"
          class="relative inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-200/90 dark:border-slate-700/80 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-sm transition-all duration-200 hover:scale-105"
        >
          <svg class="w-4 h-4 text-amber-400 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 text-indigo-600 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span id="themeToggleLabel" class="hidden sm:inline">Theme</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Banner -->
  <div class="relative z-10 border-b border-slate-200/80 dark:border-slate-800/80 py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-2 mb-5">
        <a href="/" class="hover:text-indigo-600 dark:hover:text-white transition">Directory Home</a>
        <span>/</span>
        <span class="text-indigo-600 dark:text-indigo-400 font-mono truncate"><%= page.slug %></span>
      </nav>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-slate-900 dark:text-white">
        <%= page.title %>
      </h1>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
            Verified 2026 Report
          </span>
          <span>
            Updated: <time datetime="<%= page.created_at %>" class="font-semibold text-slate-900 dark:text-white"><%= page.created_at ? page.created_at.split(' ')[0] : '2026' %></time>
          </span>
          <span>&bull;</span>
          <span class="font-mono text-xs text-slate-500 dark:text-slate-400">ID #<%= page.id %></span>
        </div>

        <button
          type="button"
          onclick="navigator.clipboard.writeText(window.location.href); this.textContent = '✓ Link Copied';"
          class="text-xs font-semibold px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-indigo-600 dark:text-indigo-300 border border-slate-300 dark:border-slate-700 shadow-sm transition"
        >
          Share Report Link
        </button>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main class="relative z-10 flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <article class="spotlight-card rounded-2xl p-6 sm:p-10">
      <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white pb-4 border-b border-slate-200 dark:border-slate-800">
        Executive Summary &amp; In-Depth Analysis
      </h2>

      <div class="mt-6 space-y-5 text-slate-700 dark:text-slate-200 text-base sm:text-lg leading-relaxed">
        <% page.description.split(/\n\s*\n/).forEach(function(paragraph) { %>
          <% if (paragraph.trim()) { %>
            <p><%= paragraph.trim() %></p>
          <% } %>
        <% }); %>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
        <span>Published by TechPay Editorial &amp; Data Research Team</span>
        <a href="/about" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">Read our data methodology &rarr;</a>
      </div>
    </article>

    <% if (page.faqs && page.faqs.length > 0) { %>
      <section class="spotlight-card rounded-2xl p-6 sm:p-10">
        <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Structured FAQ Schema</span>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mt-1">
              Frequently Asked Questions
            </h2>
          </div>
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300 border border-indigo-500/30">
            <%= page.faqs.length %> Verified Answers
          </span>
        </div>

        <div class="mt-6 divide-y divide-slate-200/80 dark:divide-slate-800/80">
          <% page.faqs.forEach(function(faq, index) { %>
            <div class="py-5 first:pt-0 last:pb-0">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-indigo-500/15 text-indigo-600 dark:text-indigo-300 border border-indigo-500/30 text-xs font-extrabold flex items-center justify-center shrink-0 mt-0.5">
                  Q<%= index + 1 %>
                </span>
                <span><%= faq.question %></span>
              </h3>
              <p class="mt-2.5 pl-9 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
                <%= faq.answer %>
              </p>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (relatedPages && relatedPages.length > 0) { %>
      <section class="pt-4">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Related Guides &amp; Benchmarks</h2>
          <a href="/" class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">Browse all &rarr;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% relatedPages.forEach(function(rel) { %>
            <a
              href="/<%= rel.slug %>"
              class="group spotlight-card rounded-xl p-5 hover:-translate-y-1 transition flex flex-col justify-between"
            >
              <div>
                <span class="text-xs font-mono text-indigo-600 dark:text-indigo-400">/<%= rel.slug %></span>
                <h3 class="mt-1.5 text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-300 transition">
                  <%= rel.title %>
                </h3>
              </div>
              <span class="mt-4 text-xs font-semibold text-indigo-600 dark:text-indigo-400 inline-flex items-center gap-1">
                Read guide &rarr;
              </span>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>
  </main>

  <footer class="relative z-10 border-t border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-[#050814]/90 backdrop-blur-md mt-16 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/" class="hover:text-indigo-600 dark:hover:text-white transition">Home</a>
        <a href="/about" class="hover:text-indigo-600 dark:hover:text-white transition">About Us</a>
        <a href="/contact" class="hover:text-indigo-600 dark:hover:text-white transition">Contact Us</a>
        <a href="/privacy" class="hover:text-indigo-600 dark:hover:text-white transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-indigo-600 dark:hover:text-white transition">XML Sitemap</a>
      </div>
    </div>
  </footer>

  <script>
    function updateThemeUI() {
      const isDark = document.documentElement.classList.contains('dark');
      const label = document.getElementById('themeToggleLabel');
      if (label) {
        label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
      }
    }

    function toggleTheme() {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      localStorage.setItem('techpay_theme', isDark ? 'dark' : 'light');
      updateThemeUI();
    }
    updateThemeUI();

    window.addEventListener('mousemove', (e) => {
      document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
      document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
    }, { passive: true });

    document.querySelectorAll('.spotlight-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--card-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--card-y', `${e.clientY - rect.top}px`);
      }, { passive: true });
    });
  </script>
</body>
</html>
