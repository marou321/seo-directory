<!-- views/page.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.description.replace(/\n+/g, ' ').slice(0, 158) %>" />
  <link rel="canonical" href="<%= siteUrl %>/<%= page.slug %>" />
  <meta property="og:title" content="<%= page.title %>" />
  <meta property="og:description" content="<%= page.description.replace(/\n+/g, ' ').slice(0, 158) %>" />
  <meta property="og:type" content="article" />
  <meta property="og:url" content="<%= siteUrl %>/<%= page.slug %>" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
  <% if (page.faqs && page.faqs.length > 0) { %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faqs.map(function(f) {
      return {
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      };
    })
  }) %>
  </script>
  <% } %>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col selection:bg-indigo-600 selection:text-white">

  <header class="bg-white/90 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-extrabold text-lg shadow-sm group-hover:bg-indigo-700 transition">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight text-slate-900">TechPay</span>
          <span class="text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 ml-1">Directory</span>
        </div>
      </a>
      <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="/" class="hover:text-indigo-600 transition">&larr; Back to All Guides</a>
        <a href="/sitemap.xml" class="hover:text-indigo-600 transition">XML Sitemap</a>
      </nav>
    </div>
  </header>

  <div class="bg-slate-900 text-white border-b border-slate-800 py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-xs font-medium text-slate-400 flex items-center gap-2 mb-5">
        <a href="/" class="hover:text-white transition">Directory Home</a>
        <span>/</span>
        <span class="text-indigo-300 font-mono truncate"><%= page.slug %></span>
      </nav>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
        <%= page.title %>
      </h1>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-300">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 font-medium">
          Verified Market Report
        </span>
        <span>
          Last Updated: <time datetime="<%= page.created_at %>" class="font-semibold text-white"><%= page.created_at %></time>
        </span>
        <span>&bull;</span>
        <span>Report ID: #<%= page.id %></span>
      </div>
    </div>
  </div>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <article class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-10">
      <h2 class="text-lg sm:text-xl font-bold text-slate-900 pb-4 border-b border-slate-100">
        Comprehensive Compensation &amp; Market Overview
      </h2>

      <div class="mt-6 space-y-5 text-slate-700 text-base sm:text-lg leading-relaxed">
        <% page.description.split(/\n\s*\n/).forEach(function(paragraph) { %>
          <% if (paragraph.trim()) { %>
            <p><%= paragraph.trim() %></p>
          <% } %>
        <% }); %>
      </div>
    </article>

    <% if (page.faqs && page.faqs.length > 0) { %>
      <section class="mt-10 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-10">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Structured FAQ Schema</span>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mt-1">
              Frequently Asked Questions
            </h2>
          </div>
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-700">
            <%= page.faqs.length %> Questions
          </span>
        </div>

        <div class="mt-6 divide-y divide-slate-200">
          <% page.faqs.forEach(function(faq, index) { %>
            <div class="py-5 first:pt-0 last:pb-0">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-indigo-50 text-indigo-600 text-xs font-extrabold flex items-center justify-center shrink-0 mt-0.5">
                  Q<%= index + 1 %>
                </span>
                <span><%= faq.question %></span>
              </h3>
              <p class="mt-2.5 pl-9 text-sm sm:text-base text-slate-600 leading-relaxed">
                <%= faq.answer %>
              </p>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (relatedPages && relatedPages.length > 0) { %>
      <section class="mt-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-slate-900">Related Compensation Guides</h2>
          <a href="/" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">View all &rarr;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% relatedPages.forEach(function(rel) { %>
            <a
              href="/<%= rel.slug %>"
              class="group bg-white rounded-xl border border-slate-200 p-5 hover:border-indigo-500/60 hover:shadow-md transition flex flex-col justify-between"
            >
              <div>
                <span class="text-xs font-mono text-slate-400">/<%= rel.slug %></span>
                <h3 class="mt-1 text-base font-bold text-slate-900 group-hover:text-indigo-600 transition">
                  <%= rel.title %>
                </h3>
              </div>
              <span class="mt-4 text-xs font-semibold text-indigo-600 inline-flex items-center gap-1">
                Explore benchmark &rarr;
              </span>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>
  </main>

  <footer class="bg-white border-t border-slate-200 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/" class="hover:text-slate-900 transition">Directory Index</a>
        <a href="/sitemap.xml" class="hover:text-slate-900 transition">Sitemap</a>
      </div>
    </div>
  </footer>

</body>
</html>
