<!-- views/contact.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us | TechPay Index — Tech Compensation Directory</title>
  <meta name="description" content="Get in touch with the TechPay Index editorial and data science team for compensation benchmark inquiries, data corrections, or partnership requests." />
  <link rel="canonical" href="<%= siteUrl %>/contact" />
  <meta property="og:title" content="Contact Us | TechPay Index" />
  <meta property="og:description" content="Contact the TechPay Index team for questions, feedback, or data inquiries." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/contact" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col selection:bg-indigo-600 selection:text-white">

  <header class="bg-white/90 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-extrabold text-lg shadow-sm group-hover:bg-indigo-700 transition">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight text-slate-900">TechPay</span>
          <span class="hidden sm:inline-block text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 ml-1">Directory</span>
        </div>
      </a>
      <nav class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-slate-600">
        <a href="/" class="hover:text-indigo-600 transition">Home</a>
        <a href="/about" class="hover:text-indigo-600 transition">About Us</a>
        <a href="/contact" class="text-indigo-600 font-semibold">Contact</a>
        <a href="/privacy" class="hover:text-indigo-600 transition">Privacy Policy</a>
      </nav>
    </div>
  </header>

  <section class="bg-slate-900 text-white py-14 sm:py-20 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 mb-4">
        Reader Support &amp; Inquiries
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
        Contact TechPay Index
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Have a question about our salary benchmarks, want to suggest a new role or city, or need to reach our editorial team? We would love to hear from you.
      </p>
    </div>
  </section>

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <% if (typeof submitted !== 'undefined' && submitted) { %>
      <div class="mb-8 rounded-2xl bg-emerald-50 border border-emerald-200 p-5 text-emerald-900 flex items-center justify-between">
        <div>
          <p class="font-bold text-sm uppercase tracking-wider text-emerald-700">Message Received</p>
          <p class="mt-1 text-sm">Thank you for contacting TechPay Index! Our editorial team has received your inquiry and typically responds within 1–2 business days.</p>
        </div>
        <a href="/contact" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-800 text-white hover:bg-emerald-700 transition">Close</a>
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-900">Editorial &amp; General Inquiries</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            For questions regarding our salary methodology, regional cost-of-living multipliers, or content corrections:
          </p>
          <p class="mt-3 text-sm font-semibold text-indigo-600 break-all">
            <a href="mailto:contact@techpay-directory.com" class="hover:underline">contact@techpay-directory.com</a>
          </p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-900">Advertising &amp; Partnerships</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            For sponsorship inquiries, data licensing, or advertising policy questions:
          </p>
          <p class="mt-3 text-sm font-semibold text-indigo-600 break-all">
            <a href="mailto:partnerships@techpay-directory.com" class="hover:underline">partnerships@techpay-directory.com</a>
          </p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-900">Response Time</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            We review all reader submissions Monday through Friday and aim to respond to all messages within 24 to 48 hours.
          </p>
        </div>
      </div>

      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Send Us a Message</h2>
        <p class="mt-1 text-sm text-slate-500">
          Fill out the form below and our team will get back to you promptly.
        </p>

        <form action="/contact" method="POST" class="mt-6 space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">Your Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">Email Address *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">Subject *</label>
            <select
              id="subject"
              name="subject"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white"
            >
              <option value="Salary Benchmark Question">Salary Benchmark Question</option>
              <option value="Request New Role or City">Request a New Tech Role or City</option>
              <option value="Data Correction / Feedback">Data Correction or Editorial Feedback</option>
              <option value="Advertising / Partnership">Advertising or Partnership Inquiry</option>
              <option value="Privacy / Legal Question">Privacy Policy or Legal Question</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">Message *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="How can our team help you?"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
            ></textarea>
          </div>

          <button
            type="submit"
            class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-md shadow-indigo-600/20 transition"
          >
            Submit Inquiry
          </button>
        </form>
      </div>
    </div>
  </main>

  <footer class="bg-white border-t border-slate-200 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/" class="hover:text-slate-900 transition">Home</a>
        <a href="/about" class="hover:text-slate-900 transition">About Us</a>
        <a href="/contact" class="hover:text-slate-900 transition">Contact Us</a>
        <a href="/privacy" class="hover:text-slate-900 transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-slate-900 transition">Sitemap</a>
      </div>
    </div>
  </footer>

</body>
</html>
