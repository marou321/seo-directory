<!-- views/contact.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us | TechPay Directory</title>
  <meta name="description" content="Contact the TechPay Directory editorial and data engineering team for benchmark inquiries, content feedback, or partnership requests." />
  <link rel="canonical" href="<%= siteUrl %>/contact" />
  <meta property="og:title" content="Contact Us | TechPay Directory" />
  <meta property="og:description" content="Get in touch with the TechPay Directory team." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/contact" />
  <!-- Google AdSense Auto-Ads Verification Script -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
    .glass-card {
      background: rgba(15, 23, 42, 0.68);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white relative overflow-x-hidden">

  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-sky-500/15 rounded-full blur-3xl"></div>
  </div>

  <header class="bg-slate-950/75 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-sky-500 to-emerald-400 flex items-center justify-center text-slate-950 font-extrabold text-lg shadow-lg shadow-indigo-500/25">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-white via-slate-100 to-indigo-300 bg-clip-text text-transparent">TechPay</span>
          <span class="hidden sm:inline-block text-[11px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 ml-1.5">
            Directory
          </span>
        </div>
      </a>
      <nav class="flex flex-wrap items-center gap-4 sm:gap-7 text-xs sm:text-sm font-medium text-slate-300">
        <a href="/" class="hover:text-white transition">Home</a>
        <a href="/about" class="hover:text-white transition">About Us</a>
        <a href="/contact" class="text-white font-semibold">Contact</a>
        <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
      </nav>
    </div>
  </header>

  <section class="py-14 sm:py-20 border-b border-slate-800/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 mb-4">
        Reader Support &amp; Inquiries
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Contact TechPay Directory
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Questions about our technical benchmarks, data methodology, or partnership opportunities? Send our team a message below.
      </p>
    </div>
  </section>

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <% if (typeof submitted !== 'undefined' && submitted) { %>
      <div class="mb-8 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 p-5 text-emerald-200 flex items-center justify-between">
        <div>
          <p class="font-bold text-xs uppercase tracking-wider text-emerald-400">Inquiry Received</p>
          <p class="mt-1 text-sm">Thank you for contacting TechPay Directory! Our editorial team typically responds within 1–2 business days.</p>
        </div>
        <a href="/contact" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-500/20 text-white hover:bg-emerald-500/30 transition">Close</a>
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="space-y-6">
        <div class="glass-card rounded-2xl p-6">
          <h2 class="text-base font-bold text-white">Editorial &amp; Data Research</h2>
          <p class="mt-2 text-sm text-slate-300 leading-relaxed">
            For questions regarding our technical guides, salary percentiles, or topic suggestions:
          </p>
          <p class="mt-3 text-sm font-semibold text-indigo-400 break-all">
            <a href="mailto:contact@techpay-directory.com" class="hover:underline">contact@techpay-directory.com</a>
          </p>
        </div>

        <div class="glass-card rounded-2xl p-6">
          <h2 class="text-base font-bold text-white">Partnerships &amp; Advertising</h2>
          <p class="mt-2 text-sm text-slate-300 leading-relaxed">
            For sponsorship inquiries, API licensing, or compliance questions:
          </p>
          <p class="mt-3 text-sm font-semibold text-indigo-400 break-all">
            <a href="mailto:partnerships@techpay-directory.com" class="hover:underline">partnerships@techpay-directory.com</a>
          </p>
        </div>
      </div>

      <div class="lg:col-span-2 glass-card rounded-2xl p-6 sm:p-10">
        <h2 class="text-xl sm:text-2xl font-bold text-white">Send Us a Message</h2>
        <form action="/contact" method="POST" class="mt-6 space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Your Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Email Address *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Subject *</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="Benchmark Inquiry / Topic Suggestion"
              class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Message *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="How can our team help you?"
              class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
            ></textarea>
          </div>

          <button
            type="submit"
            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-sky-600 hover:from-indigo-500 hover:to-sky-500 text-white font-semibold text-sm shadow-lg shadow-indigo-600/20 transition"
          >
            Submit Inquiry
          </button>
        </form>
      </div>
    </div>
  </main>

  <footer class="border-t border-slate-800/80 bg-slate-950/90 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/" class="hover:text-white transition">Home</a>
        <a href="/about" class="hover:text-white transition">About Us</a>
        <a href="/contact" class="hover:text-white transition">Contact Us</a>
        <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-white transition">XML Sitemap</a>
      </div>
    </div>
  </footer>

</body>
</html>
