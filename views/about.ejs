<!-- views/about.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us | TechPay Index — Tech Compensation & Market Directory</title>
  <meta name="description" content="Learn how TechPay Index collects, analyzes, and publishes localized technology compensation benchmarks, cost-of-living insights, and career guides." />
  <link rel="canonical" href="<%= siteUrl %>/about" />
  <meta property="og:title" content="About Us | TechPay Index" />
  <meta property="og:description" content="Discover our methodology for transparent, data-driven technology salary benchmarks across major US tech hubs." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/about" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col selection:bg-indigo-600 selection:text-white">

  <header class="bg-white/90 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-extrabold text-lg shadow-sm group-hover:bg-indigo-700 transition">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight text-slate-900">TechPay</span>
          <span class="hidden sm:inline-block text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 ml-1">Directory</span>
        </div>
      </a>
      <nav class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-slate-600">
        <a href="/" class="hover:text-indigo-600 transition">Home</a>
        <a href="/about" class="text-indigo-600 font-semibold">About Us</a>
        <a href="/contact" class="hover:text-indigo-600 transition">Contact</a>
        <a href="/privacy" class="hover:text-indigo-600 transition">Privacy Policy</a>
      </nav>
    </div>
  </header>

  <section class="bg-slate-900 text-white py-14 sm:py-20 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 mb-4">
        Our Mission &amp; Methodology
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
        About TechPay Compensation Directory
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Empowering software engineers, data scientists, cloud architects, and hiring managers with transparent, localized compensation intelligence.
      </p>
    </div>
  </section>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <article class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-10 space-y-6 text-slate-700 leading-relaxed">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">What We Offer</h2>
        <p class="mt-3">
          <strong>TechPay Index</strong> is an independent, data-driven compensation and career intelligence directory built specifically for technology professionals. Navigating salary negotiations, relocation decisions, and equity packages can be challenging when compensation data is fragmented or outdated. Our platform bridges this gap by combining structured regional salary benchmarks with clear, role-specific market analysis across major technology hubs.
        </p>
        <p class="mt-3">
          Every report in our directory provides a detailed breakdown of base salary percentiles (25th, Median, and 75th percentiles), year-over-year compensation growth rates, local cost-of-living adjustments, and frequently asked career questions tailored to each specific role and city.
        </p>
      </div>

      <div class="border-t border-slate-100 pt-6">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Our Data &amp; Editorial Methodology</h2>
        <p class="mt-3">
          Our research pipeline aggregates publicly reported compensation filings, regional cost-of-living indices, and employer salary disclosures. We normalize base compensation across metropolitan tiers—ranging from Tier-1 global hubs like San Francisco, New York City, and Seattle to high-growth hubs like Austin and Denver—and enrich each report with structured insights covering:
        </p>
        <ul class="mt-4 space-y-2.5 list-disc list-inside text-slate-700">
          <li><strong>Percentile Benchmarks:</strong> Clear salary bands from mid-level (25th percentile) to senior/lead specialists (75th percentile).</li>
          <li><strong>Total Compensation Context:</strong> Guidance on annual performance bonuses, restricted stock units (RSUs), and early-stage equity grants.</li>
          <li><strong>Purchasing Power &amp; Cost of Living:</strong> How state taxes, housing costs, and hybrid work policies affect real take-home pay.</li>
          <li><strong>Actionable FAQs:</strong> Practical answers to common negotiation and career advancement questions for each locality.</li>
        </ul>
      </div>

      <div class="border-t border-slate-100 pt-6">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Editorial Independence &amp; Transparency</h2>
        <p class="mt-3">
          TechPay Index is committed to accuracy, transparency, and reader trust. Our salary guides are continuously reviewed and updated on an automated schedule to reflect current hiring conditions and macroeconomic shifts. To keep our research freely accessible to all job seekers and students without paywalls, our platform is supported by non-intrusive display advertising and partnerships governed by our <a href="/privacy" class="text-indigo-600 font-semibold hover:underline">Privacy Policy</a>.
        </p>
      </div>

      <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50 rounded-xl p-6">
        <div>
          <h3 class="text-base font-bold text-slate-900">Have questions or feedback on a salary report?</h3>
          <p class="text-sm text-slate-600 mt-1">Reach out to our editorial and data research team anytime.</p>
        </div>
        <a href="/contact" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition shrink-0 text-center">
          Contact Us &rarr;
        </a>
      </div>
    </article>
  </main>

  <footer class="bg-white border-t border-slate-200 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/" class="hover:text-slate-900 transition">Home</a>
        <a href="/about" class="hover:text-slate-900 transition">About Us</a>
        <a href="/contact" class="hover:text-slate-900 transition">Contact Us</a>
        <a href="/privacy" class="hover:text-slate-900 transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-slate-900 transition">Sitemap</a>
      </div>
    </div>
  </footer>

</body>
</html>
