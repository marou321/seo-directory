<!-- views/about.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us | TechPay Directory — Architecture &amp; Compensation Intelligence</title>
  <meta name="description" content="Learn how TechPay Directory researches, curates, and publishes technology architecture guides, AI workflows, and localized compensation benchmarks." />
  <link rel="canonical" href="<%= siteUrl %>/about" />
  <meta property="og:title" content="About Us | TechPay Directory" />
  <meta property="og:description" content="Discover our methodology for transparent, data-driven technology benchmarks and career guides." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/about" />
  <!-- Google AdSense Auto-Ads Verification Script -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4588627708948117" crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
    .glass-card {
      background: rgba(15, 23, 42, 0.68);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white relative overflow-x-hidden">

  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-sky-500/15 rounded-full blur-3xl"></div>
  </div>

  <header class="bg-slate-950/75 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-sky-500 to-emerald-400 flex items-center justify-center text-slate-950 font-extrabold text-lg shadow-lg shadow-indigo-500/25">
          T
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-white via-slate-100 to-indigo-300 bg-clip-text text-transparent">TechPay</span>
          <span class="hidden sm:inline-block text-[11px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 ml-1.5">
            Directory
          </span>
        </div>
      </a>
      <nav class="flex flex-wrap items-center gap-4 sm:gap-7 text-xs sm:text-sm font-medium text-slate-300">
        <a href="/" class="hover:text-white transition">Home</a>
        <a href="/about" class="text-white font-semibold">About Us</a>
        <a href="/contact" class="hover:text-white transition">Contact</a>
        <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
      </nav>
    </div>
  </header>

  <section class="py-14 sm:py-20 border-b border-slate-800/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 mb-4">
        Our Mission &amp; Methodology
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        About TechPay Directory
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Delivering transparent, data-driven engineering benchmarks, AI automation guides, and localized compensation insights across global technology hubs.
      </p>
    </div>
  </section>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <article class="glass-card rounded-2xl p-6 sm:p-10 space-y-6 text-slate-300 leading-relaxed">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white">What We Offer</h2>
        <p class="mt-3">
          <strong>TechPay Directory</strong> is an independent technical research and compensation intelligence platform built for software engineers, data scientists, DevOps architects, and engineering leaders. We publish over 100 structured, in-depth guides covering modern software architecture, AI/LLM production workflows, fintech infrastructure, and localized salary percentiles.
        </p>
      </div>

      <div class="border-t border-slate-800 pt-6">
        <h2 class="text-xl sm:text-2xl font-bold text-white">Our Research &amp; Editorial Standards</h2>
        <p class="mt-3">
          Every report in our directory is structured around measurable industry benchmarks, real-world engineering trade-offs, and verified regional market multipliers:
        </p>
        <ul class="mt-4 space-y-2.5 list-disc list-inside text-slate-300">
          <li><strong>Compensation Percentiles:</strong> Clear 25th, 50th (median), and 75th percentile salary bands adjusted for local cost-of-living dynamics.</li>
          <li><strong>Architecture &amp; AI Workflows:</strong> Actionable implementation blueprints for RAG pipelines, PostgreSQL tuning, Kubernetes FinOps, and CI/CD automation.</li>
          <li><strong>Structured Schema Metadata:</strong> Validated JSON-LD (<code class="text-indigo-300">Article</code> and <code class="text-indigo-300">FAQPage</code>) on every guide for maximum clarity.</li>
        </ul>
      </div>

      <div class="border-t border-slate-800 pt-6">
        <h2 class="text-xl sm:text-2xl font-bold text-white">Editorial Independence &amp; Transparency</h2>
        <p class="mt-3">
          To keep all reports free and accessible without paywalls, TechPay Directory is supported by compliant display advertising governed by our <a href="/privacy" class="text-indigo-400 font-semibold hover:underline">Privacy Policy</a>. If you have questions or want to request a new benchmark topic, reach out via our <a href="/contact" class="text-indigo-400 font-semibold hover:underline">Contact Us</a> page.
        </p>
      </div>
    </article>
  </main>

  <footer class="border-t border-slate-800/80 bg-slate-950/90 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; <%= new Date().getFullYear() %> TechPay Programmatic SEO Directory. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/" class="hover:text-white transition">Home</a>
        <a href="/about" class="hover:text-white transition">About Us</a>
        <a href="/contact" class="hover:text-white transition">Contact Us</a>
        <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
        <a href="/sitemap.xml" class="hover:text-white transition">XML Sitemap</a>
      </div>
    </div>
  </footer>

</body>
</html>
